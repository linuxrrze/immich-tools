# Settings for the Docker container: docker run --env-file .env ...
# Same settings as config.ini, named <SECTION>_<KEY>; they override config.ini.
# Write values without quotes: `docker run --env-file` keeps them literally.
# Comments must be on their own line.

IMMICH_APIURL=https://immich.example.com/api
IMMICH_APIKEY=YOUR_IMMICH_API_KEY

# Only needed for add_image_description.py
# Any OpenAI-compatible API, e.g. Ollama: http://<host>:11434/v1
LLM_BASE_URL=http://ollama.example.com:11434/v1
# Ollama ignores the key; set a real key for OpenAI or other hosted APIs
LLM_API_KEY=ollama
LLM_MODEL=gemma3:27b
LLM_PROMPT=Describe the image in English. Do not use any introductory words.

# Only needed for migrate_nextcloud.py
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=YOUR_NEXTCLOUD_USER
# App password: Nextcloud → Personal settings → Security → Create new app password
NEXTCLOUD_PASSWORD=YOUR_NEXTCLOUD_APP_PASSWORD
# Folder to migrate, relative to your Nextcloud root (empty: everything)
NEXTCLOUD_FOLDER=Photos
# Album and tag names without the folder above (Photos/2019 -> 2019); no = full path
NEXTCLOUD_STRIP_FOLDER=yes
# Restore migrated photos that are in the Immich trash; no = skip them
NEXTCLOUD_RESTORE_TRASHED=yes
